-- Logique d'orbite visible des accessoires
local orbitActive = false
local orbitParts = {}

btnOrbit.MouseButton1Click:Connect(function()
	orbitActive = not orbitActive
	local char = LocalPlayer.Character
	if not char then return end
	
	if orbitActive then
		btnOrbit.Text = "Désactiver Orbite"
		btnOrbit.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
		orbitParts = {}
		
		for _, obj in ipairs(char:GetChildren()) do
			if obj:IsA("Accessory") then
				local handle = obj:FindFirstChild("Handle")
				if handle then
					-- Détache les welds pour permettre le mouvement libre
					for _, c in ipairs(handle:GetChildren()) do
						if c:IsA("Weld") or c:IsA("Motor6D") or c:IsA("Attachment") then c:Destroy() end
					end
					handle.Anchored = false
					table.insert(orbitParts, handle)
				end
			end
		end
	else
		btnOrbit.Text = "Activer Orbite Accessoires"
		btnOrbit.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
		orbitActive = false
		char:BreakJoints() -- Remet le personnage propre
	end
end)

-- Boucle d'animation de l'orbite
RunService.Heartbeat:Connect(function()
	if not orbitActive then return end
	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local t = tick() * 8
	local total = #orbitParts
	if total == 0 then return end

	for i, handle in ipairs(orbitParts) do
		if handle and handle.Parent then
			pcall(function()
				handle:WakeUp()
				local angle = t + ((i / total) * (math.pi * 2))
				local radius = 3.5
				local pos = hrp.Position + Vector3.new(math.cos(angle) * radius, 2, math.sin(angle) * radius)
				handle.CFrame = CFrame.new(pos) * CFrame.Angles(t, t * 1.5, 0)
			end)
		end
	end
end)

-- Bouton Danse
btnDance.MouseButton1Click:Connect(function()
	pcall(function()
		local char = LocalPlayer.Character
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://" .. tostring(IDS.Dance)
		local track = hum:LoadAnimation(anim)
		track:Play()
	end)
end)

