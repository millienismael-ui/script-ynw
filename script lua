-- 2. Logique de l'Orbite avec une Épée du catalogue (Asset ID d'une épée classique Roblox)
local orbitActive = false
local spawnedParts = {}
local SWORD_ID = 126955541 -- ID d'un accessoire d'épée stylé sur Roblox

toggleButton.MouseButton1Click:Connect(function()
	orbitActive = not orbitActive
	local character = LocalPlayer.Character
	if not character then return end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	if orbitActive then
		toggleButton.Text = "Orbite Épée : ON"
		toggleButton.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
		spawnedParts = {}

		-- Charge l'épée depuis Roblox de manière sécurisée
		pcall(function()
			local model = InsertService:LoadAsset(SWORD_ID)
			for _, item in ipairs(model:GetChildren()) do
				if item:IsA("Accessory") then
					item.Parent = character
					local handle = item:FindFirstChild("Handle")
					if handle then
						for _, c in ipairs(handle:GetChildren()) do
							if c:IsA("Weld") or c:IsA("Motor6D") or c:IsA("Attachment") then c:Destroy() end
						end
						handle.Anchored = false
						table.insert(spawnedParts, handle)
					end
				end
			end
		end)

		-- Ajoute aussi les accessoires existants du joueur pour faire un effet de groupe
		for _, obj in ipairs(character:GetChildren()) do
			if obj:IsA("Accessory") then
				local handle = obj:FindFirstChild("Handle")
				if handle and not table.find(spawnedParts, handle) then
					for _, c in ipairs(handle:GetChildren()) do
						if c:IsA("Weld") or c:IsA("Motor6D") or c:IsA("Attachment") then c:Destroy() end
					end
					handle.Anchored = false
					table.insert(spawnedParts, handle)
				end
			end
		end
	else
		toggleButton.Text = "Orbite Épée : OFF"
		toggleButton.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
		orbitActive = false
		LocalPlayer.Character:BreakJoints() -- Reset propre pour remettre l'avatar d'origine
	end
end)

-- Boucle d'animation fluide en orbite serrée
RunService.Heartbeat:Connect(function()
	if not orbitActive then return end
	local character = LocalPlayer.Character
	if not character then return end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local t_tick = tick() * 8
	local total = #spawnedParts
	if total == 0 then return end

	for i, handle in ipairs(spawnedParts) do
		if handle and handle.Parent then
			pcall(function()
				handle:WakeUp()
				local angle = t_tick + ((i / total) * (math.pi * 2))
		local radius = 3.5 -- Cercle très proche et dynamique autour du joueur
				local pos = hrp.Position + Vector3.new(math.cos(angle) * radius, 1.5, math.sin(angle) * radius)
				handle.CFrame = CFrame.new(pos) * CFrame.Angles(t_tick, t_tick * 1.5, 0)
			end)
		end
	end
end)
