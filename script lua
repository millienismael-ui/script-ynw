-- Fonction de recherche de cible (Logique Traverser les Murs corrigée)
local function getClosestTarget()
	local closestPlayer = nil
	local shortestDistance = Config.FOV
	local mousePos = UserInputService:GetMouseLocation()

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			local head = player.Character:FindFirstChild("Head")
			
			if humanoid and humanoid.Health > 0 and head then
				local isValid = true
				
				-- Seulement si "Traverser les Murs" est DÉSACTIVÉ, on applique le test Raycast
				if not Config.ThroughWalls then
					local origin = Camera.CFrame.Position
					local direction = (head.Position - origin)
					local raycastParams = RaycastParams.new()
					raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, player.Character}
					raycastParams.FilterType = RaycastType.Exclude
					local result = workspace:Raycast(origin, direction, raycastParams)
					if result then
						isValid = false -- Obstacle détecté
					end
				end
				
				if isValid then
					local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
					if onScreen then
						local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
						local distance = (screenPos - mousePos).Magnitude
						
						if distance < shortestDistance then
							shortestDistance = distance
							closestPlayer = head
						end
					end
				end
			end
		end
	end
	return closestPlayer
end

-- Boucle principale
RunService.RenderStepped:Connect(function(dt)
	local mousePos = UserInputService:GetMouseLocation()
	
	FOVFrame.Size = UDim2.new(0, Config.FOV * 2, 0, Config.FOV * 2)
	FOVFrame.Position = UDim2.new(0, mousePos.X, 0, mousePos.Y)
	FOVFrame.Visible = Config.Enabled

	CrosshairH.Visible = Config.Enabled and Config.Crosshair
	CrosshairV.Visible = Config.Enabled and Config.Crosshair

	-- Mouvements Joueur
	local char = LocalPlayer.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")

	if char and humanoid and hrp then
		if Config.WalkSpeedEnabled then humanoid.WalkSpeed = Config.WalkSpeedValue end
		if Config.Spin then hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(35), 0) end

		if Config.Fly then
			if not flyBodyVelocity then
				flyBodyVelocity = Instance.new("BodyVelocity")
				flyBodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
				flyBodyVelocity.Parent = hrp
			end
			if not flyBodyGyro then
				flyBodyGyro = Instance.new("BodyGyro")
				flyBodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
				flyBodyGyro.Parent = hrp
			end
			
			local camCFrame = Camera.CFrame
			local moveDir = Vector3.new()
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camCFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camCFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camCFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camCFrame.RightVector end
			
			flyBodyVelocity.Velocity = moveDir * (Config.FlySpeed * 1.5)
			flyBodyGyro.CFrame = camCFrame
			humanoid.PlatformStand = true
		else
			if flyBodyVelocity then flyBodyVelocity:Destroy() flyBodyVelocity = nil end
			if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
			if humanoid.PlatformStand then humanoid.PlatformStand = false end
		end
	end

	-- ESP & Tracers
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local pChar = player.Character
			local pHum = pChar and pChar:FindFirstChildOfClass("Humanoid")
			local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
			
			if Config.Enabled and Config.ESPBoxes and pChar and pHum and pHum.Health > 0 then
				if not highlights[player] then
					local hl = Instance.new("Highlight")
					hl.FillTransparency = 1
					hl.OutlineColor = Color3.fromRGB(0, 255, 0)
					hl.OutlineTransparency = 0
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					hl.Parent = pChar
					highlights[player] = hl
				else
					highlights[player].Parent = pChar
					highlights[player].Enabled = true
				end
			elseif highlights[player] then
				highlights[player].Enabled = false
			end
			
			-- Tracers accrochés exactement aux pieds
			local tracer = getTracer(player)
			if Config.Enabled and Config.Tracers and pChar and pRoot and pHum and pHum.Health > 0 then
				-- Position 3D au niveau du sol des pieds (-3.2 studs sous le RootPart)
				local feetPos3D = pRoot.Position - Vector3.new(0, 3.2, 0)
				local feetScreenPos, onScreen = Camera:WorldToViewportPoint(feetPos3D)
				
				if onScreen then
					local bottomScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
					local targetScreen = Vector2.new(feetScreenPos.X, feetScreenPos.Y)
					local dist = (targetScreen - bottomScreen).Magnitude
					
					tracer.Size = UDim2.new(0, 1.5, 0, dist)
					tracer.Position = UDim2.new(0, (bottomScreen.X + targetScreen.X) / 2, 0, (bottomScreen.Y + targetScreen.Y) / 2)
					tracer.AnchorPoint = Vector2.new(0.5, 0.5)
					tracer.Rotation = math.deg(math.atan2(targetScreen.Y - bottomScreen.Y, targetScreen.X - bottomScreen.X)) - 90
					tracer.Visible = true
				else
					tracer.Visible = false
				end
			else
				tracer.Visible = false
			end
		end
	end

	-- Lock de l'Aim Assist (Maintenir clic droit)
	if Config.Enabled and Config.AimAssist and isRightMouseDown then
		if not lockedTarget or not lockedTarget.Parent or lockedTarget.Parent:FindFirstChildOfClass("Humanoid").Health <= 0 then
			lockedTarget = getClosestTarget()
		end

		if lockedTarget then
			local targetCFrame = CFrame.new(Camera.CFrame.Position, lockedTarget.Position)
			local alpha = math.clamp(dt * (22 - Config.Smoothness), 0.05, 1)
			Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, alpha)
		end
	else
		lockedTarget = nil
	end
end)
