-- 2. Logique de l'Orbite des Accessoires (Visible pour tout le monde)
local orbitActive = false
local managedAccessories = {}

toggleButton.MouseButton1Click:Connect(function()
	orbitActive = not orbitActive
	local character = LocalPlayer.Character
	if not character then return end

	if orbitActive then
		toggleButton.Text = "Orbite Chapeaux : ON"
		toggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 100) -- Vert actif
		managedAccessories = {}

		-- Détache les accessoires pour les libérer en orbite
		for _, obj in ipairs(character:GetChildren()) do
			if obj:IsA("Accessory") then
				local handle = obj:FindFirstChild("Handle")
				if handle then
					-- Supprime les liaisons d'origine pour reprendre le contrôle physique
					for _, child in ipairs(handle:GetChildren()) do
						if child:IsA("Weld") or child:IsA("Motor6D") or child:IsA("Attachment") then
							child:Destroy()
						end
					end
					handle.Anchored = false
					table.insert(managedAccessories, handle)
				end
			end
		end
	else
		toggleButton.Text = "Orbite Chapeaux : OFF"
		toggleButton.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
		
		-- Réinitialise le personnage pour remonter les chapeaux proprement à l'arrêt
		orbitActive = false
		LocalPlayer.Character:BreakJoints() -- Fait respawn le joueur pour nettoyer
	end
end)

-- Boucle fluide d'animation en cercle autour du joueur
RunService.Heartbeat:Connect(function()
	if not orbitActive then return end
	
	local character = LocalPlayer.Character
	if not character then return end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local currentTime = tick() * 6
	local totalHats = #managedAccessories
	if totalHats == 0 then return end

	for i, handle in ipairs(managedAccessories) do
		if handle and handle.Parent then
			pcall(function()
				handle.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
				handle:WakeUp()

				-- Calcul d'un cercle parfait autour du joueur
				local angle = currentTime + ((i / totalHats) * (math.pi * 2))
				local radius = 4 -- Distance du cercle par rapport à toi
				local targetPos = hrp.Position + Vector3.new(
					math.cos(angle) * radius,
					2 + (math.sin(currentTime * 2 + i) * 0.5), -- Petit effet de flottement vertical
					math.sin(angle) * radius
				)

				-- Applique la position et fait tourner l'objet sur lui-même
				handle.CFrame = CFrame.new(targetPos) * CFrame.Angles(currentTime, currentTime, 0)
			end)
		end
	end
end)
