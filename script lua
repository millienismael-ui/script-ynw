-- Raccourcis Clavier Alt et M
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.KeyCode == Enum.KeyCode.LeftAlt or input.KeyCode == Enum.KeyCode.RightAlt then
		mainFrame.Visible = not mainFrame.Visible
		notifLabel.Text = mainFrame.Visible and "Interface : Active" or "Interface : Masquée"
	elseif input.KeyCode == Enum.KeyCode.M then
		mainFrame.Visible = true
		notifLabel.Text = "Interface : Réaffichée"
	end
end)

-- Variables pour l'orbite
local spawnedObjects = {}
local orbitActive = false

-- Actions des boutons (génération 3D instantanée visible)
btnHelmet.MouseButton1Click:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end
	local head = char:FindFirstChild("Head")
	if not head then return end

	local helmetPart = Instance.new("Part")
	helmetPart.Size = Vector3.new(1.3, 1.3, 1.3)
	helmetPart.Color = Color3.fromRGB(200, 0, 0)
	helmetPart.Material = Enum.Material.Neon
	helmetPart.CFrame = head.CFrame
	helmetPart.Parent = workspace
	
	table.insert(spawnedObjects, helmetPart)
	orbitActive = true
end)

btnSword.MouseButton1Click:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local blade = Instance.new("Part")
	blade.Size = Vector3.new(0.4, 4, 0.8)
	blade.Color = Color3.fromRGB(120, 120, 255)
	blade.Material = Enum.Material.Glass
	blade.CFrame = hrp.CFrame + Vector3.new(2, 0, 0)
	blade.Parent = workspace
	
	table.insert(spawnedObjects, blade)
	orbitActive = true
end)

-- Animation fluide de l'orbite autour de toi
RunService.Heartbeat:Connect(function()
	if not orbitActive or #spawnedObjects == 0 then return end
	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local t = tick() * 6
	local total = #spawnedObjects

	for i, obj in ipairs(spawnedObjects) do
		if obj and obj.Parent then
			pcall(function()
				local angle = t + ((i / total) * (math.pi * 2))
				local radius = 3.2
				local pos = hrp.Position + Vector3.new(math.cos(angle) * radius, 1.5, math.sin(angle) * radius)
				obj.CFrame = CFrame.new(pos) * CFrame.Angles(0, t, 0)
			end)
		end
	end
end)

-- Bouton Danse (ID d'animation fonctionnel)
btnDance.MouseButton1Click:Connect(function()
	pcall(function()
		local char = LocalPlayer.Character
		if not char then return end
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not humanoid then return end
		
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://127517106825603"
		local track = humanoid:LoadAnimation(anim)
		track:Play()
	end)
end)

-- Bouton Reset
btnReset.MouseButton1Click:Connect(function()
	spawnedObjects = {}
	orbitActive = false
	if LocalPlayer.Character then
		LocalPlayer.Character:BreakJoints()
	end
end)
