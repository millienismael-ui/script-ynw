-- Tracers collés exactement aux pieds
local function getTracer(player)
	if not tracerFrames[player] then
		local line = Instance.new("Frame")
		line.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
		line.BackgroundTransparency = 0.3
		line.BorderSizePixel = 0
		line.Size = UDim2.new(0, 1.5, 0, 0)
		line.Visible = false
		line.Parent = ScreenGui
		tracerFrames[player] = line
	end
	return tracerFrames[player]
end

Players.PlayerRemoving:Connect(function(player)
	if tracerFrames[player] then tracerFrames[player]:Destroy() tracerFrames[player] = nil end
	if highlights[player] then highlights[player]:Destroy() highlights[player] = nil end
end)

