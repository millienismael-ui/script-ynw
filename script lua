-- Helper : Trouver la partie principale/tête de n'importe quel personnage (Standard ou Custom Rivals)
local function getTargetPart(character)
	if not character then return nil end
	
	-- Recherche des pièces habituelles
	local priorityParts = {"Head", "HeadHitbox", "Hitbox", "HumanoidRootPart", "UpperTorso", "Torso"}
	for _, name in ipairs(priorityParts) do
		local part = character:FindFirstChild(name, true) -- Recherche récursive
		if part and part:IsA("BasePart") then
			return part
		end
	end
	
	-- Si aucune pièce spécifique n'est trouvée, prendre n'importe quelle BasePart
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("BasePart") then
			return child
		end
	end
	return nil
end

local function getTracer(player)
	if not tracerFrames[player] then
		local line = Instance.new("Frame")
		line.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
		line.BackgroundTransparency = 0.3
		line.BorderSizePixel = 0
		line.Size = UDim2.new(0, 1.5, 0, 0)
		line.Visible = false
		line.Parent = ScreenGui
		tracerFrames[player] = line
	end
	return tracerFrames[player]
end

