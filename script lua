-- Fonction utilitaire pour créer des boutons bascules (toggles) futuristes avec UICorner et son de clic
local function createToggle(name, defaultState, callback)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, 0, 0, 36)
	container.BackgroundTransparency = 1
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.68, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Gotham
	label.Text = name
	label.TextColor3 = Color3.fromRGB(210, 210, 230)
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = container
	
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(0, 56, 0, 26)
	button.Position = UDim2.new(1, -56, 0.5, -13)
	button.BackgroundColor3 = defaultState and Color3.fromRGB(0, 229, 255) or Color3.fromRGB(35, 35, 50)
	button.AutoButtonColor = false
	button.Text = ""
	button.Parent = container
	
	-- Bouton avec coins arrondis (UICorner)
	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 6)
	btnCorner.Parent = button

	-- Contour néon discret pour les boutons
	local btnStroke = Instance.new("UIStroke")
	btnStroke.Color = defaultState and Color3.fromRGB(150, 245, 255) or Color3.fromRGB(60, 60, 85)
	btnStroke.Transparency = 0.2
	btnStroke.Parent = button
	
	local state = defaultState
	button.MouseButton1Click:Connect(function()
		state = not state
		ClickSound:Play() -- Lecture du son de clic demandé (140910211)
		
		button.BackgroundColor3 = state and Color3.fromRGB(0, 229, 255) or Color3.fromRGB(35, 35, 50)
		btnStroke.Color = state and Color3.fromRGB(150, 245, 255) or Color3.fromRGB(60, 60, 85)
		callback(state)
	end)
	
	container.Parent = ContentContainer
end

