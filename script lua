-- Tracers et ESP (Gestion via Highlight/GUI natifs)
local highlights = {}

local function updateESP()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			if Config.Enabled and Config.ESPBoxes and player.Character then
				if not highlights[player] then
					local hl = Instance.new("Highlight")
					hl.Name = "YNW_ESP"
					hl.FillTransparency = 1
					hl.OutlineColor = Color3.fromRGB(0, 255, 0) -- Vert
					hl.OutlineTransparency = 0
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					hl.Parent = player.Character
					highlights[player] = hl
				else
					highlights[player].Parent = player.Character
					highlights[player].Enabled = true
				end
			elseif highlights[player] then
				highlights[player].Enabled = false
			end
		end
	end
end

