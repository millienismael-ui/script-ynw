-- Fonction de mise à jour dynamique de la liste des joueurs connectés
local function updatePlayerListUI()
	for _, child in ipairs(playerListScroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	
	local count = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			count = count + 1
			local pBtn = Instance.new("TextButton")
			pBtn.Size = UDim2.new(1, -10, 0, 24)
			pBtn.BackgroundColor3 = (Config.SelectedTargetPlayer == player) and Color3.fromRGB(80, 80, 80) or Color3.fromRGB(30, 30, 30)
			pBtn.Font = Enum.Font.Gotham
			pBtn.Text = "  [ " .. player.Name .. " ]"
			pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			pBtn.TextSize = 11
			pBtn.TextXAlignment = Enum.TextXAlignment.Left
			pBtn.Parent = playerListScroll
			
			local btnCorner = Instance.new("UICorner")
			btnCorner.CornerRadius = UDim.new(0, 4)
			btnCorner.Parent = pBtn
			
			pBtn.MouseButton1Click:Connect(function()
				pcall(function() ClickSound:Play() end)
				if Config.SelectedTargetPlayer == player then
					Config.SelectedTargetPlayer = nil -- Désélectionner
				else
					Config.SelectedTargetPlayer = player -- Sélectionner spécifiquement ce joueur
				end
				updatePlayerListUI()
			end)
		end
	end
	playerListScroll.CanvasSize = UDim2.new(0, 0, 0, count * 28)
end

Players.PlayerAdded:Connect(updatePlayerListUI)
Players.PlayerRemoving:Connect(updatePlayerListUI)
updatePlayerListUI()

