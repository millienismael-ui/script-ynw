-- Raccourcis Clavier Alt et M
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.KeyCode == Enum.KeyCode.LeftAlt or input.KeyCode == Enum.KeyCode.RightAlt then
		mainFrame.Visible = not mainFrame.Visible
		notifLabel.Text = mainFrame.Visible and "Interface : Affichée" or "Interface : Masquée"
	elseif input.KeyCode == Enum.KeyCode.M then
		mainFrame.Visible = true
		notifLabel.Text = "Interface : Réaffichée"
	end
end)

-- Tes 4 IDs officiels intégrés
local IDS = {
	Helmet = 113655181607111, --[cite: 8]
	Dance = 127517106825603,
	AnimSword = 77123023523467, --[cite: 10]
	Sword = 147143863 --[cite: 11]
}

-- 2. Actions des boutons avec chargement sécurisé (LoadAsset)
btnHelmet.MouseButton1Click:Connect(function()
	pcall(function()
		local model = InsertService:LoadAsset(IDS.Helmet)
		local char = LocalPlayer.Character
		if char then
			for _, item in ipairs(model:GetChildren()) do
				if item:IsA("Accessory") then
					item.Parent = char
				end
			end
		end
	end)
end)

btnSword.MouseButton1Click:Connect(function()
	pcall(function()
		local model = InsertService:LoadAsset(IDS.Sword)
		local char = LocalPlayer.Character
		if char then
			for _, item in ipairs(model:GetChildren()) do
				if item:IsA("Tool") or item:IsA("Accessory") then
					item.Parent = char
				end
			end
		end
	end)
end)

btnDance.MouseButton1Click:Connect(function()
	pcall(function()
		local char = LocalPlayer.Character
		if not char then return end
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not humanoid then return end
		
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://" .. tostring(IDS.Dance)
		local track = humanoid:LoadAnimation(anim)
		track:Play()
	end)
end)

btnAnimSword.MouseButton1Click:Connect(function()
	pcall(function()
		local char = LocalPlayer.Character
		if not char then return end
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not humanoid then return end
		
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://" .. tostring(IDS.AnimSword)
		local track = humanoid:LoadAnimation(anim)
		track:Play()
	end)
end)
